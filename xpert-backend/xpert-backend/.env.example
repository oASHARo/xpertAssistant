# HTTP server
PORT=4000 # HTTP port
HOST=0.0.0.0 # Bind address
NODE_ENV=development # development, production, or test

# PostgreSQL control-plane database
CONTROL_PLANE_DATABASE_URL=postgresql://postgres:password@localhost:5432/xpert_assistant # Database connection string
TENANT_DATABASE_URL=postgresql://postgres:password@localhost:5432/xpert_dev_db # Prisma CLI placeholder; runtime tenant URLs come from the control plane
TENANT_CREDENTIALS_KEY=base64-encoded-32-byte-key # AES-256 key; generate with: openssl rand -base64 32

# Authentication
JWT_SECRET=replace-with-a-long-random-secret # JWT signing secret
JWT_ACCESS_EXPIRY=10m # Access token lifetime
JWT_REFRESH_EXPIRY=7d # Refresh token lifetime

# SMTP
SMTP_HOST=smtp.example.com # SMTP server hostname
SMTP_PORT=587 # SMTP server port
SMTP_USER=your-smtp-user # SMTP username
SMTP_PASS=your-smtp-password # SMTP password
SMTP_FROM=no-reply@example.com # Sender address

# LLM
LLM_PROVIDER=openai # preferred provider: openai, grok, or anthropic
LLM_API_KEY= # legacy key for the selected LLM_PROVIDER (optional)
LLM_OPENAI_API_KEY= # OpenAI key (optional)
LLM_GROK_API_KEY= # xAI/Grok key, or Groq key beginning with gsk_ (optional)
LLM_ANTHROPIC_API_KEY= # Anthropic/Claude key (optional)
LLM_GROK_BASE_URL=https://api.x.ai/v1 # Grok OpenAI-compatible endpoint
LLM_GROK_MODEL=grok-3-mini # xAI model; Groq keys use the currently supported Groq model automatically

# File storage
STORAGE_PROVIDER=local # local or s3
STORAGE_LOCAL_DIR=./uploads # Local upload directory
CORS_ORIGIN=http://localhost:3000 # Allowed frontend origin
