{
  "name": "xpert-backend",
  "version": "1.0.0",
  "description": "Xpert Assistant backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run prisma:generate:control && npm run prisma:generate:tenant && tsc && node scripts/copy-generated.mjs",
    "start": "node dist/server.js",
    "test": "vitest run",
    "prisma:generate:control": "prisma generate --schema=src/db/prisma/control-plane.prisma",
    "prisma:generate:tenant": "prisma generate --schema=src/db/prisma/tenant.prisma"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/client": "^6.15.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "fastify-plugin": "^6.0.0",
    "mammoth": "^1.12.3",
    "nodemailer": "^10.0.0",
    "openai": "^7.15.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "^1.1.5",
    "form-data": "^4.0.6",
    "prisma": "^6.15.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
